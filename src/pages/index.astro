---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Marquee from "../components/Marquee.astro";
import Studio from "../components/Studio.astro";
import Bench from "../components/Bench.astro";
import Footer from "../components/Footer.astro";
import ProjectDialog from "../components/ProjectDialog.astro";
---

<BaseLayout
  title="Tiny Melo — Little tools. A lot of heart."
  description="Tiny Melo is Christopher’s independent home for thoughtful apps, useful tools, and experiments. Explore Melo TV, ZipMelo, and more."
  activeNav="home"
  skipTo="#work"
>
  <Hero />
  <Projects />
  <Marquee />
  <Studio />
  <Bench />
  <Footer />
  <ProjectDialog slot="modal" />
</BaseLayout>

<script>
  import { initHomeAnimations } from "../scripts/homeAnimations";
  initHomeAnimations();
</script>
