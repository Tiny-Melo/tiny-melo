---
import Arrow from '../components/Arrow.astro';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInit from '../components/ThemeInit.astro';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="Tiny Melo is Christopher’s independent home for thoughtful apps, useful tools, and experiments. Explore Melloku, Speakmelo, BrewPulse, and more." />
<title>Tiny Melo — Little tools. A lot of heart.</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#faf8f3" />
<ThemeInit />
</head>
<body>
<a class="skip-link" href="#work">Skip to projects</a>
<SiteHeader />
<main>
<section class="hero wrap" aria-labelledby="hero-heading">
<p class="eyebrow"><span class="little-line"></span> AN INDEPENDENT LITTLE STUDIO</p>
<h1 id="hero-heading">Little tools.<br /><span class="heart-line">A lot of <em>heart.</em></span></h1>
<p class="hero-description">A home for the things I make.<br />Thoughtful apps, useful tools, and the occasional rabbit hole.</p>
<div class="hero-actions"><a class="button primary" href="#work">Meet the projects <Arrow direction="down-right" /></a><a class="button secondary" href="/about">A little about Melo <Arrow /></a></div>
<div class="hero-shelf" aria-label="Projects made by Tiny Melo">
<a class="app-tile tile-reader" href="#melloku" aria-label="Explore Melloku"><img src="/assets/melloku.png" alt="" /><span>Melloku</span></a>
<a class="app-tile tile-voice" href="#speakmelo" aria-label="Explore Speakmelo"><img src="/assets/speakmelo.png" alt="" /><span>Speakmelo</span></a>
<a class="app-tile tile-brew" href="#brewpulse" aria-label="Explore BrewPulse"><img src="/assets/brewpulse.png" alt="" /><span>BrewPulse</span></a>
<div class="shelf-note">a few things<br />from my desk <span>⤴</span></div>
</div>
<div class="hero-bottom"><span>Small studio. Personal projects.</span><a href="#work">SCROLL TO EXPLORE <span>↓</span></a><span>Crafted with care by Melo</span></div>
</section>
<section id="work" class="work wrap">
<div class="section-heading"><div><p class="eyebrow">FROM THE WORKBENCH</p><h2>A few things<br />I've been making<span class="gold">.</span></h2></div><p>Some solve an everyday problem.<br />Some start with “what if?”<br />All have a little Melo in them.</p></div>
<div class="project-grid">
<article id="melloku" class="project-card reader-card wide">
<div class="card-copy"><div class="card-meta"><span>THE READER</span><span class="status">In development</span></div><h3>Melloku</h3><p>Your manga. Your pace.<br />A native home for your next chapter.</p><button class="text-link" data-project="melloku">Take a closer look <Arrow /></button><span class="platform">iOS & macOS</span></div>
<div class="reader-art project-art"><div class="reader-orbit"></div><img src="/assets/melloku.png" alt="Melloku’s flowing gold mark" /><div class="art-caption"><span>ONE MORE CHAPTER.</span><span>And then one more.</span></div></div>
</article>
<article id="speakmelo" class="project-card voice-card wide">
<div class="card-copy"><div class="card-meta"><span>THE VOICE</span><span class="status">In development</span></div><h3>Speakmelo</h3><p>From a thought to a sentence.<br />Dictation that lives on your Mac.</p><button class="text-link" data-project="speakmelo">Take a closer look <Arrow /></button><span class="platform">macOS</span></div>
<div class="voice-art project-art"><img class="voice-mark" src="/assets/speakmelo.png" alt="Speakmelo app mark" /><div class="waveform" aria-hidden="true">{Array.from({length: 29}, (_,i) => <i style={`--height: ${14 + Math.abs(Math.sin(i * 1.9)) * 48}px; --delay: ${i * .045}s`}></i>)}</div><div class="voice-caption">A little less typing.<br /><strong>A little more you.</strong></div></div>
</article>
<article id="brewpulse" class="project-card brew-card"><div class="small-art project-art"><img src="/assets/brewpulse-status.png" alt="BrewPulse’s Homebrew package status window" loading="lazy" /></div><div class="small-copy"><div class="card-meta"><span>THE DAILY HELPER</span><span class="status">Public beta</span></div><h3>BrewPulse</h3><p>Homebrew updates, without living in Terminal.</p><button class="text-link" data-project="brewpulse">Explore BrewPulse <Arrow /></button></div></article>
<article id="zipmello" class="project-card zip-card"><div class="small-art zip-art project-art"><img src="/assets/zipmello.png" alt="ZipMello’s golden retriever character" loading="lazy" /><span class="zip-type" aria-hidden="true">zip.<br />read.<br />repeat.</span></div><div class="small-copy"><div class="card-meta"><span>UNDER THE HOOD</span><span class="status">Open source</span></div><h3>ZipMello</h3><p>A Swift ZIP engine built for comic readers.</p><button class="text-link" data-project="zipmello">Explore ZipMello <Arrow /></button></div></article>
</div>
<p class="work-footnote">Always tinkering. More things are on the way. <a href="https://github.com/tinymelo" target="_blank" rel="noreferrer">Follow along <Arrow /></a></p>
</section>
<section class="marquee" aria-label="The Tiny Melo project family"><div class="marquee-track" aria-hidden="true">{[0,1].map(() => <span>Melloku <b>✳</b> Speakmelo <b>✳</b> BrewPulse <b>✳</b> ZipMello <b>✳</b> MelloRunner <b>✳</b></span>)}</div></section>
<section id="studio" class="studio wrap"><div class="studio-top"><p class="eyebrow">ONE HUMAN. ONE VERY GOOD DOG.</p><span>That's the studio.</span></div><h2>Built by a person.<br />Approved by <span class="inline-dog"><img src="/assets/melo.jpg" alt="Melo the golden retriever" loading="lazy" /></span> Melo.</h2><div class="studio-body"><p class="reveal-words">Tiny Melo is my corner of the internet. I'm Christopher, and this is where my apps, experiments, and small obsessions find a home.</p><div class="studio-aside"><p>The name belongs to Melo, the golden retriever. The code is mine. The laid-back energy is definitely his.</p><a class="text-link" href="https://github.com/tinymelo" target="_blank" rel="noreferrer">See what I'm working on <Arrow /></a><a class="about-preview-link" href="/about">More about the human behind Tiny Melo <Arrow /></a></div></div><figure class="melo-portrait"><img src="/assets/melo.jpg" alt="An illustration of Melo resting with his head on his paws" loading="lazy" /><figcaption>Melo, head of taking it easy.</figcaption></figure></section>
<section class="bench wrap"><div><p class="eyebrow">A PEEK BEHIND THE APPS</p><h2>Small pieces.<br />Thoughtfully built.</h2></div><div class="spotlight"><div class="spotlight-top"><span id="spotlight-count">01 / 03</span><div class="spotlight-controls"><button id="spotlight-prev" aria-label="Previous project"><Arrow direction="left" /></button><button id="spotlight-next" aria-label="Next project"><Arrow direction="right" /></button></div></div><div id="spotlight-content" aria-live="polite"><img id="spotlight-image" src="/assets/zipmello.png" alt="ZipMello mark" loading="lazy" /><h3 id="spotlight-title">ZipMello</h3><p id="spotlight-description">A ZIP and CBZ engine for Swift, built around how comic readers actually access pages.</p><a id="spotlight-link" class="text-link" href="https://github.com/ChrisRodStar/zipmello" target="_blank" rel="noreferrer"><span>View the source</span> <Arrow /></a></div></div></section>
<footer class="footer"><div class="wrap"><p class="eyebrow">THERE'S ALWAYS ANOTHER LITTLE IDEA.</p><h2>See you around<br />the workbench<span>.</span></h2><a class="button primary" href="https://github.com/tinymelo" target="_blank" rel="noreferrer">Follow the next little thing <Arrow /></a><div class="footer-bottom"><a href="#" class="brand"><img src="/assets/paw.svg" width="30" height="30" alt="" />tiny melo.</a><span>© {new Date().getFullYear()} Tiny Melo</span><a href="#">Back to the top <Arrow direction="up" /></a></div></div></footer>
</main>
<dialog id="project-dialog" aria-labelledby="dialog-title"><div class="dialog-shell"><button class="dialog-close" aria-label="Close project details">×</button><img id="dialog-image" src="/assets/melloku.png" alt="" /><p id="dialog-status" class="eyebrow"></p><h2 id="dialog-title"></h2><p id="dialog-description"></p><ul id="dialog-features"></ul><a id="dialog-link" class="button primary" target="_blank" rel="noreferrer">View project <Arrow /></a></div></dialog>
<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
const projects = {
melloku: {name:'Melloku',status:'In development · iOS & macOS',image:'melloku.png',description:'A native manga and comics reader for iPhone and Mac. Built around a personal library and a comfortable reading experience.',features:['Library, reading history, discovery, and search','Local storage for reading positions and preferences','A personal project still in development'],url:null},
speakmelo:{name:'Speakmelo',status:'In development · macOS',image:'speakmelo.png',description:'A native Mac dictation app that turns speech into text and delivers it to the app you are using.',features:['A global shortcut and recording overlay','Custom vocabulary and local dictation history','Optional text cleanup'],url:null},
brewpulse:{name:'BrewPulse',status:'Public beta · macOS',image:'brewpulse.png',description:'A small menu bar app for checking and updating Homebrew packages. It shows what needs attention and lets you review the command before it runs.',features:['See outdated formulae and casks','Review Homebrew commands before updating','Open-source client; current beta is unsigned'],url:'https://github.com/ChrisRodStar/BrewPulse'},
zipmello:{name:'ZipMello',status:'Open source · Swift',image:'zipmello.png',description:'A Swift ZIP and CBZ engine built around the access patterns of comic and manga readers.',features:['Natural page ordering','Concurrent, positional archive reads','Direct in-memory archive processing'],url:'https://github.com/ChrisRodStar/zipmello'}
};
const dialog = document.querySelector<HTMLDialogElement>('#project-dialog')!;
document.querySelectorAll<HTMLButtonElement>('[data-project]').forEach(button => button.addEventListener('click', () => {
const project = projects[button.dataset.project as keyof typeof projects];
document.querySelector('#dialog-title')!.textContent = project.name;
document.querySelector('#dialog-status')!.textContent = project.status;
document.querySelector('#dialog-description')!.textContent = project.description;
(document.querySelector('#dialog-image') as HTMLImageElement).src = `/assets/${project.image}`;
const list = document.querySelector('#dialog-features')!; list.replaceChildren(...project.features.map(text => {const li = document.createElement('li');li.textContent = text;return li;}));
const link = document.querySelector<HTMLAnchorElement>('#dialog-link')!; link.hidden = !project.url; if(project.url) link.href = project.url;
dialog.showModal();document.body.classList.add('modal-open');
}));
dialog.querySelector('.dialog-close')!.addEventListener('click',()=>dialog.close());
dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
dialog.addEventListener('close',()=>document.body.classList.remove('modal-open'));
const spotlights = [
{name:'ZipMello',image:'zipmello.png',description:'A ZIP and CBZ engine for Swift, built around how comic readers actually access pages.',url:'https://github.com/ChrisRodStar/zipmello',link:'View the source'},
{name:'MelloRunner',image:'mellorunner.png',description:'An independent source runner for Melloku. The current foundation checks WebAssembly headers and input limits; module execution is still ahead.',url:null,link:''},
{name:'BrewPulse',image:'brewpulse.png',description:'A native layer over Homebrew. The command stays visible, so you can see exactly what your Mac is about to do.',url:'https://github.com/ChrisRodStar/BrewPulse',link:'View the source'}
];
let current = 0;
function updateSpotlight(delta:number){current=(current+delta+spotlights.length)%spotlights.length;const item=spotlights[current];document.querySelector('#spotlight-count')!.textContent=`0${current+1} / 03`;document.querySelector('#spotlight-title')!.textContent=item.name;document.querySelector('#spotlight-description')!.textContent=item.description;const image=document.querySelector<HTMLImageElement>('#spotlight-image')!;image.src=`/assets/${item.image}`;image.alt=`${item.name} mark`;const link=document.querySelector<HTMLAnchorElement>('#spotlight-link')!;link.hidden=!item.url;if(item.url){link.href=item.url;link.querySelector('span')!.textContent=item.link;}}
document.querySelector('#spotlight-prev')!.addEventListener('click',()=>updateSpotlight(-1));document.querySelector('#spotlight-next')!.addEventListener('click',()=>updateSpotlight(1));
const motion = gsap.matchMedia();
motion.add('(prefers-reduced-motion: no-preference)',()=>{
gsap.from('.hero h1, .hero-description, .hero-actions',{y:25,opacity:0,duration:.9,stagger:.12,ease:'power3.out'});
gsap.from('.app-tile',{y:45,opacity:0,duration:1.1,stagger:.1,delay:.3,ease:'power3.out'});
gsap.utils.toArray<HTMLElement>('.project-art').forEach(art=>{gsap.fromTo(art,{scale:.88},{scale:1,ease:'none',scrollTrigger:{trigger:art,start:'top 95%',end:'top 35%',scrub:1}});gsap.to(art,{opacity:.25,ease:'none',scrollTrigger:{trigger:art,start:'bottom 15%',end:'bottom -25%',scrub:1}});});
const paragraph=document.querySelector('.reveal-words')!;const words=paragraph.textContent!.trim().split(/\s+/);paragraph.replaceChildren(...words.map(word=>{const span=document.createElement('span');span.textContent=word+' ';return span;}));
gsap.fromTo('.reveal-words span',{opacity:.18},{opacity:1,stagger:.1,ease:'none',scrollTrigger:{trigger:paragraph,start:'top 85%',end:'bottom 45%',scrub:1}});
});
</script>
</body>
</html>
