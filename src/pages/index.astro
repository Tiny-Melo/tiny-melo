---
import Arrow from "../components/Arrow.astro";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
import "@fontsource/geist/600.css";
import "@fontsource/geist/700.css";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" /><meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        />
        <meta
            name="description"
            content="Tiny Melo is Christopher’s independent home for thoughtful apps, useful tools, and experiments. Explore Melo TV, ZipMelo, and more."
        />
        <title>Tiny Melo — Little tools. A lot of heart.</title>
        <link
            rel="icon"
            type="image/svg+xml"
            href="/brand/favicons/favicon.svg"
        />
        <link rel="icon" sizes="any" href="/brand/favicons/favicon.ico" />
        <link
            rel="apple-touch-icon"
            href="/brand/favicons/favicon-brand-180.png"
        />
        <link rel="manifest" href="/brand/favicons/site.webmanifest" />
        <meta
            property="og:title"
            content="Tiny Melo — Little tools. A lot of heart."
        />
        <meta
            property="og:description"
            content="Tiny Melo is Christopher’s independent home for thoughtful apps, useful tools, and experiments."
        />
        <meta
            property="og:image"
            content="/brand/social/social-card-brand-1200.png"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            name="twitter:image"
            content="/brand/social/social-card-brand-1200.png"
        />
        <meta name="theme-color" content="#F7F4EC" />
        <ThemeInit />
    </head>
    <body>
        <a class="skip-link" href="#work">Skip to projects</a>
        <SiteHeader />
        <main>
            <section class="hero wrap" aria-labelledby="hero-heading">
                <p class="eyebrow">
                    <span class="little-line"></span> AN INDEPENDENT LITTLE STUDIO
                </p>
                <h1 id="hero-heading">
                    Little tools.<br /><span class="heart-line"
                        >A lot of <em>heart.</em></span>
                </h1>
                <p class="hero-description">
                    A home for the things I make.<br />Thoughtful apps, useful
                    tools, and the occasional rabbit hole.
                </p>
                <div class="hero-actions">
                    <a class="button primary" href="#work"
                        >Meet the projects <Arrow direction="down-right" /></a
                    ><a class="button secondary" href="/about"
                        >A little about Melo <Arrow /></a>
                </div>
                <div class="hero-shelf" aria-label="Projects made by Tiny Melo">
                    <a
                        class="app-tile tile-tv"
                        href="#melotv"
                        aria-label="Explore Melo TV"
                        ><img src="/assets/melotv.svg" alt="" /><span
                            >Melo TV</span
                        ></a
                    >
                    <a
                        class="app-tile tile-zip"
                        href="#zipmelo"
                        aria-label="Explore ZipMelo"
                        ><img src="/assets/zipmelo.png" alt="" /><span
                            >ZipMelo</span
                        ></a
                    >
                    <div class="shelf-note">
                        two things<br />from my desk <span>⤴</span>
                    </div>
                </div>
                <div class="hero-bottom">
                    <span>Small studio. Personal projects.</span><a href="#work"
                        >SCROLL TO EXPLORE <span>↓</span></a
                    ><span>Crafted with care by Melo</span>
                </div>
            </section>
            <section id="work" class="work wrap">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">FROM THE WORKBENCH</p><h2>
                            A few things<br />I've been making<span class="gold"
                                >.</span>
                        </h2>
                    </div><p>
                        Some solve an everyday problem.<br />Some start with
                        “what if?”<br />All have a little Melo in them.
                    </p>
                </div>
                <div class="project-grid">
                    <article id="melotv" class="project-card tv-card wide">
                        <div class="card-copy">
                            <div class="card-meta">
                                <span>STREAMING SUITE</span><span class="status"
                                    >Open source</span>
                            </div><h3>Melo TV</h3><p>
                                Movies and TV on your own server.<br />A clean, self-hosted
                                streaming suite for Mac, iPhone, web, and Docker.
                            </p><button class="text-link" data-project="melotv"
                                >Take a closer look <Arrow /></button
                            ><span class="platform">macOS · iOS · Web · Docker</span>
                        </div>
                        <div class="tv-art project-art">
                            <img
                                src="/assets/melotv.svg"
                                alt="Melo TV streaming display mark"
                            /><div class="art-caption">
                                <span>STREAM FREELY.</span><span
                                    >Your movies. Your server.</span>
                            </div>
                        </div>
                    </article>
                    <article id="zipmelo" class="project-card zip-card wide">
                        <div class="card-copy">
                            <div class="card-meta">
                                <span>UNDER THE HOOD</span><span class="status"
                                    >Open source · Swift 6</span>
                            </div><h3>ZipMelo</h3><p>
                                Fast, memory-safe ZIP & CBZ engine.<br />Built around how
                                comic and manga readers actually access pages.
                            </p><button
                                class="text-link"
                                data-project="zipmelo"
                                >Take a closer look <Arrow /></button
                            ><span class="platform">Swift 6 · macOS CLI</span>
                        </div>
                        <div class="small-art zip-art project-art">
                            <img
                                src="/assets/zipmelo.png"
                                alt="ZipMelo’s golden retriever character"
                                loading="lazy"
                            /><span class="zip-type" aria-hidden="true"
                                >zip.<br />read.<br />repeat.</span>
                        </div>
                    </article>
                </div>
                <p class="work-footnote">
                    Always tinkering. More things are on the way. <a
                        href="https://github.com/tinymelo"
                        target="_blank"
                        rel="noreferrer">Follow along <Arrow /></a>
                </p>
            </section>
            <section class="marquee" aria-label="The Tiny Melo project family">
                <div class="marquee-track" aria-hidden="true">
                    {
                        [0, 1, 2, 3].map(() => (
                            <span>
                                Melo TV <b>✳</b> ZipMelo <b>✳</b>{" "}
                            </span>
                        ))
                    }
                </div>
            </section>
            <section id="studio" class="studio wrap">
                <div class="studio-top">
                    <p class="eyebrow">ONE HUMAN. ONE VERY GOOD DOG.</p><span
                        >That's the studio.</span>
                </div><h2>
                    Built by a person.<br />Approved by <span class="inline-dog"
                        ><img
                            src="/brand/logos/dog-coral.svg"
                            alt="Melo the golden retriever"
                            loading="lazy"
                        /></span
                    > Melo.
                </h2><div class="studio-body">
                    <p class="reveal-words">
                        Tiny Melo is my corner of the internet. I'm Christopher,
                        and this is where my apps, experiments, and small
                        obsessions find a home.
                    </p><div class="studio-aside">
                        <p>
                            The name belongs to Melo, the golden retriever. The
                            code is mine. The laid-back energy is definitely
                            his.
                        </p><a
                            class="text-link"
                            href="https://github.com/tinymelo"
                            target="_blank"
                            rel="noreferrer"
                            >See what I'm working on <Arrow /></a
                        ><a class="about-preview-link" href="/about"
                            >More about the human behind Tiny Melo <Arrow /></a>
                    </div>
                </div><figure class="melo-portrait">
                    <img
                        src="/brand/logos/dog-coral.svg"
                        alt="Melo, head of taking it easy"
                        width="380"
                        height="346"
                        loading="lazy"
                    /><figcaption>Melo, head of taking it easy.</figcaption>
                </figure>
            </section>
            <section class="bench wrap">
                <div>
                    <p class="eyebrow">A PEEK BEHIND THE APPS</p><h2>
                        Small pieces.<br />Thoughtfully built.
                    </h2>
                </div><div class="spotlight">
                    <div class="spotlight-top">
                        <span id="spotlight-count">01 / 02</span><div
                            class="spotlight-controls"
                        >
                            <button
                                id="spotlight-prev"
                                aria-label="Previous project"
                                ><Arrow direction="left" /></button
                            ><button
                                id="spotlight-next"
                                aria-label="Next project"
                                ><Arrow direction="right" /></button>
                        </div>
                    </div><div id="spotlight-content" aria-live="polite">
                        <img
                            id="spotlight-image"
                            src="/assets/melotv.svg"
                            alt="Melo TV mark"
                            loading="lazy"
                        /><h3 id="spotlight-title">Melo TV</h3><p
                            id="spotlight-description"
                        >
                            A self-hosted streaming server and app suite for movies and TV shows across macOS, iOS, web, and Docker.
                        </p><a
                            id="spotlight-link"
                            class="text-link"
                            href="https://github.com/ChrisRodStar/Mello-Tv"
                            target="_blank"
                            rel="noreferrer"
                            ><span>View on GitHub</span> <Arrow /></a>
                    </div>
                </div>
            </section>
            <footer class="footer">
                <div class="wrap">
                    <p class="eyebrow">
                        THERE'S ALWAYS ANOTHER LITTLE IDEA.
                    </p><h2>
                        See you around<br />the workbench<span>.</span>
                    </h2><a
                        class="button primary"
                        href="https://github.com/tinymelo"
                        target="_blank"
                        rel="noreferrer"
                        >Follow the next little thing <Arrow /></a
                    ><div class="footer-bottom">
                        <a href="/" class="brand" aria-label="Tiny Melo"
                            ><img
                                src="/brand/logos/primary-horizontal-reverse.svg"
                                width="135"
                                height="33"
                                alt="Tiny Melo"
                            /></a
                        ><span>© {new Date().getFullYear()} Tiny Melo</span><a
                            href="#"
                            >Back to the top <Arrow direction="up" /></a>
                    </div>
                </div>
            </footer>
        </main>
        <dialog id="project-dialog" aria-labelledby="dialog-title">
            <div class="dialog-shell">
                <button class="dialog-close" aria-label="Close project details"
                    >×</button
                ><img id="dialog-image" src="/assets/melotv.svg" alt="" /><p
                    id="dialog-status"
                    class="eyebrow"
                >
                </p><h2 id="dialog-title"></h2><p id="dialog-description">
                </p><ul id="dialog-features"></ul><a
                    id="dialog-link"
                    class="button primary"
                    target="_blank"
                    rel="noreferrer">View project <Arrow /></a>
            </div>
        </dialog>
        <script>
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";
            gsap.registerPlugin(ScrollTrigger);
            const projects = {
                melotv: {
                    name: "Melo TV",
                    status: "Open source · macOS, iOS, Web & Docker",
                    image: "melotv.svg",
                    description:
                        "A self-hosted streaming server and app suite for movies and TV shows. Run it on your Mac or with Docker, and stream directly on your Mac, iPhone, or in your browser without popups or ads.",
                    features: [
                        "Self-hosted server with Docker or native Mac app support",
                        "Native iOS and web apps with clean, ad-free playback",
                        "Direct video streaming without tabs, popups, or fake buttons",
                    ],
                    url: "https://github.com/ChrisRodStar/Mello-Tv",
                },
                zipmelo: {
                    name: "ZipMelo",
                    status: "Open source · Swift 6",
                    image: "zipmelo.png",
                    description:
                        "A Swift 6 ZIP and CBZ engine built around the real-world access patterns of comic and manga readers.",
                    features: [
                        "Natural page ordering and concurrent, positional archive reads",
                        "ZIP64, zero-copy streaming, and atomic directory writes",
                        "ComicInfo XML support and a universal macOS CLI",
                    ],
                    url: "https://github.com/ChrisRodStar/zipmello",
                },
            };
            const dialog =
                document.querySelector<HTMLDialogElement>("#project-dialog")!;
            document
                .querySelectorAll<HTMLButtonElement>("[data-project]")
                .forEach((button) =>
                    button.addEventListener("click", () => {
                        const project =
                            projects[
                                button.dataset.project as keyof typeof projects
                            ];
                        document.querySelector("#dialog-title")!.textContent =
                            project.name;
                        document.querySelector("#dialog-status")!.textContent =
                            project.status;
                        document.querySelector(
                            "#dialog-description",
                        )!.textContent = project.description;
                        (
                            document.querySelector(
                                "#dialog-image",
                            ) as HTMLImageElement
                        ).src = `/assets/${project.image}`;
                        const list =
                            document.querySelector("#dialog-features")!;
                        list.replaceChildren(
                            ...project.features.map((text) => {
                                const li = document.createElement("li");
                                li.textContent = text;
                                return li;
                            }),
                        );
                        const link =
                            document.querySelector<HTMLAnchorElement>(
                                "#dialog-link",
                            )!;
                        link.hidden = !project.url;
                        if (project.url) link.href = project.url;
                        dialog.showModal();
                        document.body.classList.add("modal-open");
                    }),
                );
            dialog
                .querySelector(".dialog-close")!
                .addEventListener("click", () => dialog.close());
            dialog.addEventListener("click", (event) => {
                if (event.target === dialog) dialog.close();
            });
            dialog.addEventListener("close", () =>
                document.body.classList.remove("modal-open"),
            );
            const spotlights = [
                {
                    name: "Melo TV",
                    image: "melotv.svg",
                    description:
                        "A self-hosted streaming server and app suite for movies and TV shows across macOS, iOS, web, and Docker.",
                    url: "https://github.com/ChrisRodStar/Mello-Tv",
                    link: "View on GitHub",
                },
                {
                    name: "ZipMelo",
                    image: "zipmelo.png",
                    description:
                        "A ZIP and CBZ engine for Swift 6, built around how comic and manga readers actually access pages.",
                    url: "https://github.com/ChrisRodStar/zipmello",
                    link: "View the source",
                },
            ];
            let current = 0;
            function updateSpotlight(delta: number) {
                current =
                    (current + delta + spotlights.length) % spotlights.length;
                const item = spotlights[current];
                document.querySelector("#spotlight-count")!.textContent =
                    `0${current + 1} / 02`;
                document.querySelector("#spotlight-title")!.textContent =
                    item.name;
                document.querySelector("#spotlight-description")!.textContent =
                    item.description;
                const image =
                    document.querySelector<HTMLImageElement>(
                        "#spotlight-image",
                    )!;
                image.src = `/assets/${item.image}`;
                image.alt = `${item.name} mark`;
                const link =
                    document.querySelector<HTMLAnchorElement>(
                        "#spotlight-link",
                    )!;
                link.hidden = !item.url;
                if (item.url) {
                    link.href = item.url;
                    link.querySelector("span")!.textContent = item.link;
                }
            }
            document
                .querySelector("#spotlight-prev")!
                .addEventListener("click", () => updateSpotlight(-1));
            document
                .querySelector("#spotlight-next")!
                .addEventListener("click", () => updateSpotlight(1));
            const motion = gsap.matchMedia();
            motion.add("(prefers-reduced-motion: no-preference)", () => {
                gsap.from(".hero h1, .hero-description, .hero-actions", {
                    y: 25,
                    opacity: 0,
                    duration: 0.9,
                    stagger: 0.12,
                    ease: "power3.out",
                });
                gsap.from(".app-tile", {
                    y: 45,
                    opacity: 0,
                    duration: 1.1,
                    stagger: 0.1,
                    delay: 0.3,
                    ease: "power3.out",
                });
                gsap.utils
                    .toArray<HTMLElement>(".project-art")
                    .forEach((art) => {
                        gsap.fromTo(
                            art,
                            { scale: 0.88 },
                            {
                                scale: 1,
                                ease: "none",
                                scrollTrigger: {
                                    trigger: art,
                                    start: "top 95%",
                                    end: "top 35%",
                                    scrub: 1,
                                },
                            },
                        );
                        gsap.to(art, {
                            opacity: 0.25,
                            ease: "none",
                            scrollTrigger: {
                                trigger: art,
                                start: "bottom 15%",
                                end: "bottom -25%",
                                scrub: 1,
                            },
                        });
                    });
                const paragraph = document.querySelector(".reveal-words")!;
                const words = paragraph.textContent!.trim().split(/\s+/);
                paragraph.replaceChildren(
                    ...words.map((word) => {
                        const span = document.createElement("span");
                        span.textContent = word + " ";
                        return span;
                    }),
                );
                gsap.fromTo(
                    ".reveal-words span",
                    { opacity: 0.18 },
                    {
                        opacity: 1,
                        stagger: 0.1,
                        ease: "none",
                        scrollTrigger: {
                            trigger: paragraph,
                            start: "top 85%",
                            end: "bottom 45%",
                            scrub: 1,
                        },
                    },
                );
            });
        </script>
    </body>
</html>
