---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import "../styles/components/about.css";


---

<BaseLayout
  title="Christopher — The human behind Tiny Melo"
  description="Meet Christopher, the person behind Tiny Melo, and Melo, the golden retriever who gave the studio its name."
  activeNav="about"
  skipTo="#about-heading"
  bodyClass="about-page"
>
  <section class="about-hero wrap" aria-labelledby="about-heading">
    <div class="about-hero-layout">
      <div class="about-hero-content">
        <p class="eyebrow">THE HUMAN BEHIND TINY MELO</p>
        <h1 id="about-heading">I'm Christopher.<br />This is <em>my work.</em></h1>
        <div class="about-intro">
          <p>
            I build apps and tools under the name Tiny Melo. This is a collection
            of my personal projects, from native Apple apps to the little
            libraries underneath them.
          </p>
          <div class="about-intro-actions">
            <a class="button primary" href="/#work">Browse my work</a>
            <a
              class="text-link"
              href="https://github.com/ChrisRodStar"
              target="_blank"
              rel="noreferrer">Find me on GitHub</a>
          </div>
        </div>
      </div>
      <figure class="christopher-portrait">
        <div class="portrait-frame">
          <img
            src="/assets/christopher-portrait.png"
            alt="Portrait of Christopher wearing a charcoal shirt against a warm cream backdrop"
            width="1122"
            height="1402"
            fetchpriority="high"
          />
        </div>
        <figcaption><span>Christopher / Tiny Melo</span></figcaption>
      </figure>
    </div>
    <div class="about-hero-bottom">
      <span>Independent software projects</span><span>Built by Melo</span>
    </div>
  </section>

  <section class="about-melo wrap" aria-labelledby="melo-heading">
    <div class="about-melo-copy">
      <p class="eyebrow">THE NAME BEHIND THE NAME</p>
      <h2 id="melo-heading">I'm the human.<br />He's <em>Melo.</em></h2>
      <p>
        Tiny Melo is named after my golden retriever, Melo. He's the supervisor
        behind every project, usually sitting right next to me while I work.
      </p>
      <p>
        I handle the code. He keeps an eye on things, makes sure I take breaks,
        and holds everything to the very high standards of a golden retriever.
      </p>
      <a class="text-link" href="/">Back to the studio</a>
    </div>
    <figure class="about-dog">
      <img
        src="/assets/melo-sitting-transparent.png"
        alt="Melo sitting with his head tilted and a relaxed expression"
        width="1122"
        height="1402"
        loading="lazy"
      />
      <figcaption>Melo. Very good at being Melo.</figcaption>
    </figure>
  </section>

  <Footer />
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const motion = gsap.matchMedia();
  motion.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.from(".about-hero h1, .about-intro, .christopher-portrait", {
      opacity: 0,
      y: 24,
      duration: 0.9,
      stagger: 0.12,
      ease: "power3.out",
    });
    gsap.fromTo(
      ".about-dog img",
      { scale: 0.88 },
      {
        scale: 1,
        ease: "none",
        scrollTrigger: {
          trigger: ".about-dog",
          start: "top 95%",
          end: "top 35%",
          scrub: 1,
        },
      },
    );
  });
</script>
