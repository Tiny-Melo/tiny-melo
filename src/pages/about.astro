---
import Arrow from '../components/Arrow.astro';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInit from '../components/ThemeInit.astro';
const projects = [
  { name: 'Melloku', type: 'Native app · iOS & macOS', status: 'In development', image: 'melloku.png', description: 'A manga and comics reader with a personal library, reading history, and a home for your next chapter.', href: '/#melloku', link: 'Project details' },
  { name: 'Speakmelo', type: 'Native app · macOS', status: 'In development', image: 'speakmelo.png', description: 'Dictation for the Mac, with a global shortcut, custom vocabulary, and text delivery to the app you’re using.', href: '/#speakmelo', link: 'Project details' },
  { name: 'BrewPulse', type: 'Menu bar app · macOS', status: 'Public beta', image: 'brewpulse.png', description: 'A small interface for Homebrew updates. See what needs attention and review the command before it runs.', href: 'https://github.com/ChrisRodStar/BrewPulse', link: 'View the source' },
  { name: 'ZipMello', type: 'Developer library · Swift', status: 'Open source', image: 'zipmello.png', description: 'A ZIP and CBZ engine built for comic readers, with natural page ordering and concurrent archive reads.', href: 'https://github.com/ChrisRodStar/zipmello', link: 'View the source' },
  { name: 'MelloRunner', type: 'Developer library · Swift', status: 'In development', image: 'mellorunner.png', description: 'An independent source runner for Melloku. The foundation checks WebAssembly headers and input limits; execution is still ahead.', href: null, link: null },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Meet Christopher, the person behind Tiny Melo. A portfolio of native apps, Swift libraries, and personal software projects." />
  <title>Christopher — The human behind Tiny Melo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#faf8f3" />
  <ThemeInit />
</head>
<body class="about-page">
  <a class="skip-link" href="#portfolio">Skip to portfolio</a>
  <SiteHeader active="about" />
  <main>
    <section class="about-hero wrap" aria-labelledby="about-heading">
      <div class="about-hero-layout"><div class="about-hero-content">
      <p class="eyebrow">THE HUMAN BEHIND TINY MELO</p>
      <h1 id="about-heading">I'm Christopher.<br />This is <em>my work.</em></h1>
      <div class="about-intro">
        <p>I build apps and tools under the name Tiny Melo. This is a collection of my personal projects, from native Apple apps to the little libraries underneath them.</p>
        <div class="about-intro-actions"><a class="button primary" href="#portfolio">Browse my work <Arrow direction="down-right" /></a><a class="text-link" href="https://github.com/tinymelo" target="_blank" rel="noreferrer">Find me on GitHub <Arrow /></a></div>
      </div>
      </div><figure class="christopher-portrait"><div class="portrait-frame"><img src="/assets/christopher-portrait.png" alt="Portrait of Christopher wearing a charcoal shirt against a warm cream backdrop" width="1122" height="1402" fetchpriority="high" /></div><figcaption><span>Christopher / Tiny Melo</span></figcaption></figure></div>
      <div class="about-hero-bottom"><span>Independent software projects</span><span>Built by Melo</span></div>
    </section>
    <section class="portfolio wrap" id="portfolio" aria-labelledby="portfolio-heading">
      <div class="section-heading"><div><p class="eyebrow">MY PORTFOLIO</p><h2 id="portfolio-heading">From the app<br />to the engine<span class="gold">.</span></h2></div><p>A closer look at the collection.<br />What each project does, and where it is today.</p></div>
      <div class="portfolio-list">
        {projects.map(project => <article class="portfolio-row">
          <div class="portfolio-icon"><img src={`/assets/${project.image}`} alt={`${project.name} mark`} width="96" height="96" loading="lazy" /></div>
          <div class="portfolio-copy"><p class="portfolio-type">{project.type}</p><h3>{project.name}</h3><p>{project.description}</p></div>
          <div class="portfolio-actions"><span class="status">{project.status}</span>{project.href && <a class="text-link" href={project.href} target={project.href.startsWith('https:') ? '_blank' : undefined} rel={project.href.startsWith('https:') ? 'noreferrer' : undefined}>{project.link} <Arrow /></a>}</div>
        </article>)}
      </div>
    </section>
    <section class="about-melo wrap" aria-labelledby="melo-heading">
      <div class="about-melo-copy"><p class="eyebrow">THE NAME BEHIND THE NAME</p><h2 id="melo-heading">I'm the human.<br />He's <em>Melo.</em></h2><p>Tiny Melo takes its name from Melo, the golden retriever. He has a place here alongside the projects, usually taking it easy.</p><p>The apps, tools, and experiments are mine. This little corner of the internet carries his name.</p><a class="text-link" href="/">Back to the studio <Arrow /></a></div>
      <figure class="about-dog"><img src="/assets/melo.jpg" alt="Melo, the golden retriever, resting his head on his paws" width="1024" height="1024" loading="lazy" /><figcaption>Melo. Very good at being Melo.</figcaption></figure>
    </section>
    <footer class="footer"><div class="wrap"><p class="eyebrow">STILL AT THE WORKBENCH</p><h2>Follow the<br />next little thing<span>.</span></h2><a class="button primary" href="https://github.com/tinymelo" target="_blank" rel="noreferrer">Find Tiny Melo on GitHub <Arrow /></a><div class="footer-bottom"><a href="/" class="brand"><img src="/assets/paw.svg" width="30" height="30" alt="" />tiny melo.</a><span>© {new Date().getFullYear()} Tiny Melo</span><a href="#">Back to the top <Arrow direction="up" /></a></div></div></footer>
  </main>
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    const motion = gsap.matchMedia();
    motion.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.from('.about-hero h1, .about-intro, .christopher-portrait', { opacity: 0, y: 24, duration: .9, stagger: .12, ease: 'power3.out' });
      gsap.utils.toArray<HTMLElement>('.portfolio-row').forEach(row => gsap.from(row, { y: 24, opacity: 0, duration: .65, ease: 'power2.out', scrollTrigger: { trigger: row, start: 'top 92%', once: true } }));
      gsap.fromTo('.about-dog img', { scale: .88 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.about-dog', start: 'top 95%', end: 'top 35%', scrub: 1 } });
    });
  </script>
</body>
</html>
