---
import "../styles/components/projects.css";
---

<section id="work" class="work wrap" aria-labelledby="work-heading">
  <header class="work-heading">
    <h2 id="work-heading">Things I've made<span class="gold">.</span></h2>
  </header>

  <div class="project-collection">
    <article id="melotv" class="project-entry" aria-labelledby="melotv-heading">
      <img class="project-mark project-mark-tv" src="/assets/melotv.svg" width="144" height="128" alt="" loading="lazy" />
      <div class="project-copy">
        <h3 id="melotv-heading">Melo TV</h3>
        <p>Movies and TV from your own server.</p>
      </div>
      <button class="button secondary project-details" data-project="melotv" aria-haspopup="dialog" aria-label="View Melo TV project">View project</button>
    </article>

    <article id="zipmelo" class="project-entry" aria-labelledby="zipmelo-heading">
      <img class="project-mark" src="/assets/zipmelo.png" width="128" height="128" alt="" loading="lazy" />
      <div class="project-copy">
        <h3 id="zipmelo-heading">ZipMelo</h3>
        <p>ZIP &amp; CBZ tools for comic and manga readers.</p>
      </div>
      <button class="button secondary project-details" data-project="zipmelo" aria-haspopup="dialog" aria-label="View ZipMelo project">View project</button>
    </article>
  </div>
</section>
