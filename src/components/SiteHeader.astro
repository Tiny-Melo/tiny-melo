---
import Arrow from './Arrow.astro';
const { active } = Astro.props;
---
<header class="nav wrap">
<a href="/" class="brand" aria-label="Tiny Melo home">
  <img class="brand-logo brand-logo-light" src="/brand/logos/primary-horizontal-brand.svg" width="156" height="38" alt="Tiny Melo" />
  <img class="brand-logo brand-logo-dark" src="/brand/logos/primary-horizontal-reverse.svg" width="156" height="38" alt="Tiny Melo" />
</a>
<nav aria-label="Main navigation"><a href="/#work">The projects</a><a href="/about" aria-current={active === 'about' ? 'page' : undefined}>The human</a></nav>
<div class="nav-actions"><a class="nav-link" href="https://github.com/tinymelo" target="_blank" rel="noreferrer">Find me on GitHub <Arrow /></a>
<button class="theme-toggle" type="button" aria-label="Switch color theme" aria-pressed="false">
<svg class="theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" /></svg>
<svg class="theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button></div>
</header>
<script>import '../scripts/theme';</script>
