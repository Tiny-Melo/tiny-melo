---
import "../styles/components/header.css";
interface Props {
  active?: "home" | "about";
}
const { active } = Astro.props;
---

<header class="island-header">
  <div class="island-notch">
    <!-- Top-Left Concave Ear Flare -->
    <svg
      class="island-ear island-ear-left"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      aria-hidden="true"
    >
      <path d="M0 0 Q20 0 20 20 L20 0 Z" fill="#000000"></path>
      <path
        d="M0 0 Q20 0 20 20"
        fill="none"
        stroke="rgba(255, 255, 255, 0.14)"
        stroke-width="1"></path>
    </svg>

    <!-- Dynamic Island Body -->
    <div class="island-body">
      <a href="/" class="island-brand" aria-label="Tiny Melo home">
        <img
          src="/brand/logos/primary-horizontal-reverse.svg"
          width="116"
          height="28"
          alt="Tiny Melo"
        />
      </a>

      <nav class="island-nav" aria-label="Main navigation">
        <a href="/#work" class="island-link">The projects</a>
        <a
          href="/about"
          class="island-link"
          aria-current={active === "about" ? "page" : undefined}>The human</a
        >
        <a
          href="https://github.com/tinymelo"
          class="island-link"
          target="_blank"
          rel="noreferrer">GitHub</a
        >
      </nav>

      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch color theme"
        aria-pressed="false"
      >
        <svg
          class="theme-moon"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path></svg
        >
        <svg
          class="theme-sun"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        >
      </button>
    </div>

    <!-- Top-Right Concave Ear Flare -->
    <svg
      class="island-ear island-ear-right"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      aria-hidden="true"
    >
      <path d="M0 20 Q0 0 20 0 L0 0 Z" fill="#000000"></path>
      <path
        d="M0 20 Q0 0 20 0"
        fill="none"
        stroke="rgba(255, 255, 255, 0.14)"
        stroke-width="1"></path>
    </svg>
  </div>
</header>
<script>
  import "../scripts/theme";
</script>
