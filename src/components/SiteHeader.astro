---
import "../styles/components/header.css";
interface Props {
  active?: "home" | "about";
}
const { active } = Astro.props;
---

<header class="site-header">
  <div class="header-inner wrap">
    <a href="/" class="brand" aria-label="Tiny Melo home">
      <img
        class="brand-logo brand-logo-light"
        src="/brand/logos/primary-horizontal-brand.svg"
        width="135"
        height="33"
        alt="Tiny Melo"
      />
      <img
        class="brand-logo brand-logo-dark"
        src="/brand/logos/primary-horizontal-reverse.svg"
        width="135"
        height="33"
        alt="Tiny Melo"
      />
    </a>

    <div class="header-right">
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/#work" class="nav-item">The projects</a>
        <a
          href="/about"
          class="nav-item"
          aria-current={active === "about" ? "page" : undefined}>The human</a
        >
        <a
          href="https://github.com/tinymelo"
          class="nav-item"
          target="_blank"
          rel="noreferrer">GitHub</a
        >
      </nav>

      <button
        class="theme-toggle"
        type="button"
        aria-label="Switch color theme"
        aria-pressed="false"
      >
        <svg
          class="theme-moon"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path></svg
        >
        <svg
          class="theme-sun"
          viewBox="0 0 24 24"
          width="15"
          height="15"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        >
      </button>
    </div>
  </div>
</header>
<script>
  import "../scripts/theme";
</script>
