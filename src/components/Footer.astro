---
import "../styles/components/footer.css";

interface Props {
  heading?: string;
  subheading?: string;
}

const {
  heading = "See you around",
  subheading = "Independent apps, tools, and experiments by Christopher & Melo.",
} = Astro.props;
---

<footer class="footer wrap">
  <div class="footer-top">
    <div class="footer-message">
      <h2><Fragment set:html={heading} /><span>.</span></h2>
      <p>{subheading}</p>
    </div>
    <div class="footer-action">
      <a
        class="button secondary"
        href="https://github.com/Tiny-Melo"
        target="_blank"
        rel="noreferrer">Follow on GitHub</a
      >
    </div>
  </div>

  <div class="footer-bottom">
    <a href="/" class="footer-brand" aria-label="Tiny Melo home">
      <img
        src="/brand/logos/wordmark-reverse.svg"
        width="120"
        height="27"
        alt="Tiny Melo"
      />
    </a>
    <div class="footer-meta">
      <span>© {new Date().getFullYear()} Tiny Melo</span>
      <span class="footer-dot" aria-hidden="true">·</span>
      <a href="/about" class="footer-link">The human</a>
      <span class="footer-dot" aria-hidden="true">·</span>
      <a href="#" class="back-to-top">Back to top</a>
    </div>
  </div>
</footer>
