<script is:inline>
  (() => {
    let saved;
    try { saved = localStorage.getItem('tiny-melo-theme'); } catch {}
    const theme = saved === 'light' || saved === 'dark' ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#000000' : '#F7F4EC');
  })();
</script>
